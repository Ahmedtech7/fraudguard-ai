{
  "name": "fraudguard-node",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --env-file=.env --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "start": "node server/index.js",
    "build": "vite build",
    "train": "node scripts/train.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "@supabase/supabase-js": "^2.49.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
